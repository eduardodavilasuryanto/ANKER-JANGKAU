{
  "$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
  "name": "jangkau-api",
  "main": "worker.py",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": [
    "python_workers"
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "CORS_ORIGINS": "jangkau-webgis-len.pages.dev"
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "jangkau-auth",
      "database_id": "ecb3713a-8b6f-43f5-9e36-40ed2d7424b9",
      "migrations_dir": "migrations"
    }
  ]
}