# =============================================================================
# ANKER-JANGKAU ignore list
# Rule: Git stores the recipe and the labeled shelves. Git does not store
# groceries, secret passwords, or leftover crumbs from a local meal.
# =============================================================================

# --- Secrets and local machines ---
.env
.env.*
!.env.example
.dev.vars
.wrangler/
*.pem
*.key
secrets/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
.venv-workers/
venv/
ENV/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# --- Node / frontend ---
node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Data pantry: keep the shelves, not the groceries ---
data/raw/**
!data/raw/.gitkeep
!data/raw/README.md
data/external/**
!data/external/.gitkeep
!data/external/README.md
data/interim/**
!data/interim/.gitkeep
data/processed/**
!data/processed/.gitkeep
data/outputs/**
!data/outputs/.gitkeep
!data/outputs/README.md

# Heavy GIS originals never belong on GitHub
*.gpkg
*.gdb/
*.shp
*.shx
*.dbf
*.prj
*.sbn
*.sbx
*.cpg
*.tif
*.tiff
*.img
*.ecw
*.las
*.laz

# Runtime copies of scored layers may be committed only under these two
# public-serving folders, and only when the file is small (see GUIDEBOOK).
# Do not copy raw dumps here.

# --- OS and editors ---
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# --- Logs and temp ---
*.log
tmp/
temp/
tempCodeRunnerFile.py
.cache/
