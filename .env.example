# Copy this file to ".env" on your own machine.
# Never commit a real ".env". That file is the secret club password.

# --- Backend ---
APP_NAME=Jangkau API
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info

# Path to the scored catchment file the kitchen reads at runtime.
SCORED_GEOJSON_PATH=../data/outputs/jangkau_bogor_line_scored.geojson

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
VITE_MAPID_STYLE_URL=
VITE_MAP_DEFAULT_CENTER_LNG=106.827
VITE_MAP_DEFAULT_CENTER_LAT=-6.261
VITE_MAP_DEFAULT_ZOOM=11

# MAPID keys stay on the server or in local .env. They never go in source files.
MAPID_API_KEY=
