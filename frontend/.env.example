# Copy this file to .env.local and fill only browser-safe, domain-restricted values.
# VITE_* values are embedded in the client bundle.

VITE_MAPID_API_KEY=
# Set this only when MAPID provides a custom MapLibre style URL.
VITE_MAPID_STYLE_URL=
VITE_MAP_DEFAULT_CENTER_LNG=106.8271129
VITE_MAP_DEFAULT_CENTER_LAT=-6.1754398
VITE_MAP_DEFAULT_ZOOM=15.5
VITE_MAP_DEFAULT_PITCH=60
VITE_MAP_DEFAULT_BEARING=0
VITE_API_BASE_URL=
VITE_RELEASE_MANIFEST_URL=
